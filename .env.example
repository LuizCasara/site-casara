# Copie para `.env.local` e preencha. `.env.local` é gitignored.

# --- Telegram (notificações) ---
# Um bot só; cada notificação vai para um tópico (message_thread_id) diferente
# do mesmo grupo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=                    # teste de temperamento
TELEGRAM_LOVE_LANGUAGES_THREAD_ID=     # teste de linguagens do amor
TELEGRAM_INGRESS_THREAD_ID=            # comparações do radar em /ingress
TELEGRAM_INGRESS_CHAT_ID=              # opcional — só se o tópico do Ingress for em outro grupo (senão usa TELEGRAM_CHAT_ID)

# --- E-mail (nodemailer/Gmail, só o teste de temperamento) ---
EMAIL_USER=
EMAIL_PASS=

# --- Banco (Neon Postgres, schema `casara`) ---
DATABASE_URL=

# --- Rate limiting (Upstash Redis, lib/rate-limit.ts) ---
# Sem estas duas, o rate limiting é ignorado (fail-open) — não trava dev
# local, mas em produção deixa as rotas públicas (send-email, telegram,
# ingress-rankings, ...) sem limite algum. Free tier em upstash.com: criar um
# banco Redis e copiar "REST URL" / "REST TOKEN" do painel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
